---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="端智能学习记录" description="OnDevice Notes - 记录端侧AI学习过程">
  <!-- Hero -->
  <section class="relative py-24 px-6 text-center bg-gradient-to-b from-primary/10 to-transparent">
    <h1 class="text-5xl font-bold mb-4 bg-gradient-to-r from-primary to-purple-400 text-transparent bg-clip-text">
      端智能学习记录
    </h1>
    <p class="text-lg text-gray-400 max-w-xl mx-auto mb-8">
      把 AI 模型跑在手机上。记录从 Flutter 开发到端侧推理的完整学习路径。
    </p>
    <div class="flex justify-center gap-4">
      <a href="/notes" class="px-6 py-3 bg-primary rounded-lg font-medium hover:bg-primary/80 transition">
        开始阅读
      </a>
      <a href="https://github.com/smartbackme/on-device-notes" target="_blank"
         class="px-6 py-3 border border-gray-700 rounded-lg font-medium hover:border-gray-500 transition">
        查看源码
      </a>
    </div>
  </section>

  <!-- Learning Path -->
  <section class="max-w-5xl mx-auto px-6 py-20">
    <h2 class="text-2xl font-bold mb-10 text-center">学习路径</h2>
    <div class="grid md:grid-cols-2 gap-6">
      <div class="bg-card rounded-xl p-6 border border-gray-800 hover:border-primary/50 transition">
        <div class="text-3xl mb-3">01</div>
        <h3 class="text-lg font-semibold mb-2">模型格式与转换</h3>
        <p class="text-gray-400 text-sm">理解 ONNX、TensorFlow Lite、Core ML 的区别，实战 PyTorch 到各端的模型转换。</p>
      </div>
      <div class="bg-card rounded-xl p-6 border border-gray-800 hover:border-primary/50 transition">
        <div class="text-3xl mb-3">02</div>
        <h3 class="text-lg font-semibold mb-2">C++ 桥接与 SDK</h3>
        <p class="text-gray-400 text-sm">掌握 JNI、dart:ffi、MethodChannel，把 C++ 推理引擎接入 Flutter App。</p>
      </div>
      <div class="bg-card rounded-xl p-6 border border-gray-800 hover:border-primary/50 transition">
        <div class="text-3xl mb-3">03</div>
        <h3 class="text-lg font-semibold mb-2">推理优化</h3>
        <p class="text-gray-400 text-sm">INT8 量化、模型剪枝、算子融合，让模型在手机上跑得更快更省电。</p>
      </div>
      <div class="bg-card rounded-xl p-6 border border-gray-800 hover:border-primary/50 transition">
        <div class="text-3xl mb-3">04</div>
        <h3 class="text-lg font-semibold mb-2">端侧 RAG 与 Agent</h3>
        <p class="text-gray-400 text-sm">本地向量检索 + 小模型推理，构建不联网的 AI 助手。</p>
      </div>
    </div>
  </section>

  <!-- Tech Stack -->
  <section class="max-w-5xl mx-auto px-6 pb-20">
    <h2 class="text-2xl font-bold mb-10 text-center">技术栈</h2>
    <div class="flex flex-wrap justify-center gap-3">
      {
        ['Flutter', 'Dart', 'Python', 'C++', 'ONNX', 'TFLite', 'Core ML', 'MNN',
         'Drift', 'Riverpod', 'D1', 'Cloudflare', 'Astro'].map(tag => (
          <span class="px-4 py-2 bg-card border border-gray-700 rounded-full text-sm text-gray-300">
            {tag}
          </span>
        ))
      }
    </div>
  </section>
</BaseLayout>
